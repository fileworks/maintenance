{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Central dependency-maintenance policy for fileworks repositories.",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "prHourlyLimit": 0,
  "schedule": ["before 5am on monday"],
  "minimumReleaseAge": "7 days",
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Batch routine maintenance into one tested weekly patch release.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "bump"
      ],
      "groupName": "weekly dependency updates",
      "groupSlug": "weekly-dependency-updates",
      "automerge": true,
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Require explicit review for breaking-risk dependency changes.",
      "matchUpdateTypes": [
        "major",
        "replacement",
        "rollback"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-major"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  }
}
